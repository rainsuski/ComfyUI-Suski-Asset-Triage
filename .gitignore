# .gitignore
# ==============================================================================
# 项目代号: Asset Triage (ComfyUI-Suski-Asset-Triage)
# ==============================================================================

# 1. 插件运行时自闭环缓存与本地数据
.cache/
*.log

# 2. Python 编译字节码与缓存
__pycache__/
*.py[cod]
*$py.class

# 3. 虚拟环境
venv/
.venv/
env/

# 4. 操作系统自动生成的缩略图与索引文件
.DS_Store
Thumbs.db
desktop.ini

# 5. 编辑器工作区配置
.idea/
.vscode/*
!.vscode/settings.json